  <bpmn:sequenceFlow id="T35" name="Operativo" sourceRef="TO_QAGate" targetRef="TO_SalidaQA"/>
  <bpmn:sequenceFlow id="T36" sourceRef="TO_SalidaQA" targetRef="TO_RecQABod"/>
  <bpmn:sequenceFlow id="T37" sourceRef="TO_RecQABod" targetRef="TO_Elegible"/>
  <bpmn:sequenceFlow id="T38" sourceRef="TO_Elegible" targetRef="TO_DespTerr"/>
  <bpmn:sequenceFlow id="T39" sourceRef="TO_DespTerr" targetRef="TO_CrearIN"/>
  <bpmn:sequenceFlow id="T40" sourceRef="TO_CrearIN" targetRef="TO_Instalar"/>
  <bpmn:sequenceFlow id="T41" sourceRef="TO_Instalar" targetRef="TO_Operacion"/>
  <bpmn:sequenceFlow id="T42" sourceRef="TO_Operacion" targetRef="End_TOBE"/>
  <bpmn:sequenceFlow id="T43" name="Rechazado" sourceRef="TO_QAGate" targetRef="TO_Reingreso"/>
  <bpmn:sequenceFlow id="T44" name="Nuevo ciclo vía Bodega" sourceRef="TO_Reingreso" targetRef="TO_SalLab"/>
 </bpmn:process>
